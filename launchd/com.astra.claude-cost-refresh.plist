<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.astra.claude-cost-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/.claude/scripts/refresh-api-cost.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_ADMIN_API_KEY</key>
        <string>YOUR_ANTHROPIC_ADMIN_API_KEY</string>
        <key>ANTHROPIC_KEY_CREATED</key>
        <string>YOUR_KEY_CREATED_ISO8601</string>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/claude-cost-refresh.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/claude-cost-refresh.err</string>
</dict>
</plist>
